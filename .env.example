# EcoTrack Uganda - Environment Configuration

# === OFFLINE AI CONFIGURATION ===
# Set to true to force offline mode (skip online API attempts)
OFFLINE_MODE=false

# Ollama model to use (options: mistral, neural-chat, orca-mini, llama2)
OFFLINE_MODEL=mistral

# Ollama server URL (change if running on different port/machine)
OLLAMA_URL=http://localhost:11434

# === ONLINE AI CONFIGURATION ===
# Google Gemini API Key (optional, used if Ollama not available)
GEMINI_API_KEY=your_gemini_api_key_here

# === SERVER CONFIGURATION ===
# Server port
PORT=8001

# Node environment
NODE_ENV=development

# JWT Secret
JWT_SECRET=uganda-green-shield-2024

# === DATABASE ===
# Database file location (relative to server.js)
DB_PATH=./db.json

# === FEATURES ===
# Enable voice assistant (requires internet for now)
ENABLE_VOICE_ASSISTANT=true

# Enable local search/grounding (uses static data when offline)
ENABLE_LOCAL_SEARCH=true

# === DEVELOPMENT ===
# Enable verbose logging
DEBUG=false

# Watch mode for development
WATCH_MODE=false
